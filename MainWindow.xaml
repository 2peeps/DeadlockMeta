<Window x:Class="DeadlockMeta.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Deadlock Meta" Width="860" Height="820" MinWidth="720" MinHeight="480"
        WindowStartupLocation="CenterScreen" Background="{StaticResource Bg}"
        FontFamily="{StaticResource Body}" Foreground="{StaticResource Text}" UseLayoutRounding="True">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="64" GlassFrameThickness="0" CornerRadius="0" ResizeBorderThickness="6" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="64"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Title bar -->
        <Grid Margin="28,0,8,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="DEADLOCK META" Style="{StaticResource DisplayText}" FontSize="30" VerticalAlignment="Center"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="40,6,0,0" VerticalAlignment="Center"
                        WindowChrome.IsHitTestVisibleInChrome="True">
                <RadioButton x:Name="TabHeroes" Content="ГЕРОИ" Style="{StaticResource Tab}" GroupName="tabs" IsChecked="True" Checked="Tab_Checked"/>
                <RadioButton x:Name="TabCrosshairs" Content="ПРИЦЕЛЫ" Style="{StaticResource Tab}" GroupName="tabs" Checked="Tab_Checked"/>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top" WindowChrome.IsHitTestVisibleInChrome="True">
                <Button x:Name="UpdateButton" Visibility="Collapsed" Margin="0,16,12,0" Click="Update_Click"
                        ToolTip="Скачать новую версию и перезапустить программу">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="b" Background="{StaticResource Accent}" CornerRadius="3" Padding="12,5,12,6" Cursor="Hand">
                                <TextBlock x:Name="UpdateText" Text="{TemplateBinding Content}" FontFamily="{StaticResource Display}" FontStretch="Condensed"
                                           FontWeight="Bold" FontSize="14" Foreground="{StaticResource Bg}"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="b" Property="Background" Value="{StaticResource Text}"/>
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="b" Property="Opacity" Value="0.7"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <!-- Settings live behind the gear so new sections can be added as tabs without moving them -->
                <Button x:Name="GearButton" Content="&#xE713;" Style="{StaticResource GhostButton}" FontFamily="Segoe MDL2 Assets" FontSize="15"
                        Padding="14,10,14,9" Click="Gear_Click" ToolTip="Настройки"/>
                <Button Content="—" Style="{StaticResource GhostButton}" FontFamily="{StaticResource Body}" FontSize="13" Padding="14,10,14,10" Click="Minimize_Click"/>
                <Button Content="✕" Style="{StaticResource GhostButton}" FontFamily="{StaticResource Body}" FontSize="13" Padding="14,10,14,10" Click="Close_Click"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Height="1" Background="{StaticResource Line}"/>

        <!-- Heroes -->
        <Grid x:Name="HeroesView" Grid.Row="2" Margin="28,18,20,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Margin="0,0,8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <!-- Rank filter for the table, the builds panel and the in-game panel; filled from Settings.Ranks -->
                <StackPanel x:Name="RankPanel" Orientation="Horizontal" ToolTip="Учитываются матчи, где средний ранг обеих команд не ниже выбранного"/>
                <TextBlock x:Name="StatusText" Grid.Column="1" Foreground="{StaticResource Muted}" FontSize="12" LineHeight="16"
                           TextAlignment="Right" TextWrapping="Wrap" VerticalAlignment="Center" Margin="10,0,12,0"/>
                <Button x:Name="RefreshButton" Grid.Column="2" Content="ОБНОВИТЬ" Style="{StaticResource FlatButton}" Click="Refresh_Click"/>
            </Grid>

            <!-- Column headers; click to sort -->
            <Grid Grid.Row="1" Margin="0,20,16,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="40"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="290"/>
                    <ColumnDefinition Width="110"/>
                    <ColumnDefinition Width="110"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="#" Style="{StaticResource Label}"/>
                <Button Grid.Column="1" x:Name="SortName" Content="ГЕРОЙ" Tag="name" Style="{StaticResource GhostButton}" FontFamily="{StaticResource Display}" FontSize="14" HorizontalAlignment="Left" Click="Sort_Click"/>
                <Button Grid.Column="2" x:Name="SortWin" Content="ВИНРЕЙТ" Tag="win" Style="{StaticResource GhostButton}" FontFamily="{StaticResource Display}" FontSize="14" HorizontalAlignment="Left" Click="Sort_Click"/>
                <Button Grid.Column="3" x:Name="SortPick" Content="В МАТЧАХ" Tag="pick" Style="{StaticResource GhostButton}" FontFamily="{StaticResource Display}" FontSize="14" HorizontalAlignment="Right" Click="Sort_Click"/>
                <Button Grid.Column="4" x:Name="SortMatches" Content="ИГР" Tag="matches" Style="{StaticResource GhostButton}" FontFamily="{StaticResource Display}" FontSize="14" HorizontalAlignment="Right" Click="Sort_Click"/>
            </Grid>

            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                <ItemsControl x:Name="HeroList" Margin="0,0,8,20">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="row" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="0,7,0,7" Background="Transparent"
                                    Cursor="Hand" MouseLeftButtonUp="HeroRow_Click" ToolTip="Лучшие сборки и предметы">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="40"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="290"/>
                                        <ColumnDefinition Width="110"/>
                                        <ColumnDefinition Width="110"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Place}" Style="{StaticResource Label}" FontSize="15" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Border Width="33" Height="55" CornerRadius="2" BorderBrush="{StaticResource Line}" BorderThickness="1">
                                            <Border.Background>
                                                <ImageBrush ImageSource="{Binding Card}" Stretch="UniformToFill"/>
                                            </Border.Background>
                                        </Border>
                                        <TextBlock Text="{Binding Name}" FontFamily="{StaticResource Display}" FontStretch="Condensed" FontWeight="Bold"
                                                   FontSize="21" Foreground="{StaticResource Text}" VerticalAlignment="Center" Margin="14,0,0,0"/>
                                    </StackPanel>
                                    <!-- Winrate: number plus a bar growing left (below 50%) or right (above) from the 50% mark -->
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding WinText}" Foreground="{Binding WinBrush}" FontSize="17" FontWeight="Bold" Width="64"/>
                                        <Grid Width="200" Height="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Border Grid.ColumnSpan="2" Background="{StaticResource Panel}" CornerRadius="2"/>
                                            <Border Width="{Binding NegWidth}" Background="{StaticResource Bad}" HorizontalAlignment="Right" CornerRadius="2,0,0,2"/>
                                            <Border Grid.Column="1" Width="{Binding PosWidth}" Background="{StaticResource Good}" HorizontalAlignment="Left" CornerRadius="0,2,2,0"/>
                                            <Border Grid.ColumnSpan="2" Width="1" Background="{StaticResource Muted}" HorizontalAlignment="Center" Margin="0,-3,0,-3"/>
                                        </Grid>
                                    </StackPanel>
                                    <TextBlock Grid.Column="3" Text="{Binding PickText}" Foreground="{StaticResource Text}" FontSize="15" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="4" Text="{Binding MatchesText}" Foreground="{StaticResource Muted}" FontSize="15" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                            </Border>
                            <DataTemplate.Triggers>
                                <Trigger SourceName="row" Property="IsMouseOver" Value="True">
                                    <Setter TargetName="row" Property="Background" Value="{StaticResource Panel}"/>
                                </Trigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <TextBlock x:Name="EmptyText" Grid.Row="2" Foreground="{StaticResource Muted}" FontSize="15"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Text="Загрузка статистики…"/>
        </Grid>

        <!-- Crosshairs: catalog and the player's own list; cards and panels are built in MainWindow.Crosshairs.cs -->
        <Grid x:Name="CrosshairsView" Grid.Row="2" Margin="28,18,20,0" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Margin="0,0,8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel x:Name="CrossModePanel" Orientation="Horizontal"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="ВСТАВИТЬ КОД" Style="{StaticResource FlatButton}" Click="CrossImport_Click"
                            ToolTip="Код из игры, с сайта или от друга"/>
                    <Button Content="+ СОЗДАТЬ СВОЙ" Style="{StaticResource AccentButton}" Margin="8,0,0,0" Click="CrossCreate_Click"/>
                </StackPanel>
            </Grid>

            <!-- What the game has now and what happens next -->
            <Border x:Name="CrossBanner" Grid.Row="1" Margin="0,14,8,0" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}"
                    BorderThickness="1" CornerRadius="4" Padding="12,10,12,10"/>

            <Grid Grid.Row="2" Margin="0,14,8,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <WrapPanel x:Name="CrossShapePanel"/>
                    <WrapPanel x:Name="CrossColorPanel" Margin="0,4,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Top" HorizontalAlignment="Right">
                    <TextBlock Text="ФОН ПРЕВЬЮ" Style="{StaticResource Label}" FontSize="12" HorizontalAlignment="Right"/>
                    <StackPanel x:Name="CrossBgPanel" Orientation="Horizontal" Margin="0,4,0,0"/>
                </StackPanel>
            </Grid>

            <ScrollViewer x:Name="CrossScrollGrid" Grid.Row="3" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                <WrapPanel x:Name="CrossGrid" Margin="0,0,0,20"/>
            </ScrollViewer>
            <TextBlock x:Name="CrossEmpty" Grid.Row="3" Foreground="{StaticResource Muted}" FontSize="15" TextWrapping="Wrap" TextAlignment="Center"
                       HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="460" Visibility="Collapsed"/>
        </Grid>

        <!-- Settings -->
        <ScrollViewer x:Name="SettingsView" Grid.Row="2" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" Focusable="False">
        <StackPanel Margin="28,24,28,24">
            <TextBlock Text="ОВЕРЛЕЙ В ИГРЕ" Style="{StaticResource Label}"/>
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <CheckBox x:Name="OverlayToggle" Style="{StaticResource Toggle}" Click="OverlayToggle_Click"/>
                <TextBlock Text="Показывать винрейт при наведении на героя на экране выбора" FontSize="14" VerticalAlignment="Center" Margin="12,0,0,0"/>
            </StackPanel>
            <TextBlock Foreground="{StaticResource Muted}" FontSize="12.5" Margin="0,8,0,0" TextWrapping="Wrap"
                       Text="Игра должна работать в режиме «окно без рамки». Программа только смотрит на экран и не вмешивается в игру."/>

            <TextBlock Text="ПЕРИОД СТАТИСТИКИ" Style="{StaticResource Label}" Margin="0,30,0,0"/>
            <StackPanel x:Name="DaysPanel" Orientation="Horizontal" Margin="0,10,0,0">
                <RadioButton Content="7 ДНЕЙ" Tag="7" Style="{StaticResource Segment}" GroupName="days" Click="Days_Click"/>
                <RadioButton Content="14 ДНЕЙ" Tag="14" Style="{StaticResource Segment}" GroupName="days" Click="Days_Click"/>
                <RadioButton Content="30 ДНЕЙ" Tag="30" Style="{StaticResource Segment}" GroupName="days" Click="Days_Click"/>
            </StackPanel>

            <TextBlock Text="Ранг выбирается над таблицей героев." Foreground="{StaticResource Muted}" FontSize="12.5" Margin="0,8,0,0"/>

            <TextBlock Text="ПРИЦЕЛ" Style="{StaticResource Label}" Margin="0,30,0,0"/>
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <CheckBox x:Name="CrossGuardToggle" Style="{StaticResource Toggle}" Click="CrossGuardToggle_Click"/>
                <TextBlock Text="Возвращать мой прицел, если игра его сбросит" FontSize="14" VerticalAlignment="Center" Margin="12,0,0,0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <CheckBox x:Name="CrossHeroesToggle" Style="{StaticResource Toggle}" Click="CrossHeroesToggle_Click"/>
                <TextBlock Text="Один прицел для всех героев (убирать отдельные прицелы героев)" FontSize="14" VerticalAlignment="Center" Margin="12,0,0,0"/>
            </StackPanel>
            <TextBlock Foreground="{StaticResource Muted}" FontSize="12.5" Margin="0,8,0,10" TextWrapping="Wrap"
                       Text="Прицел записывается в файл настроек игры, только когда игра закрыта. Перед каждой записью программа сохраняет копию этого файла."/>
            <Button Content="ОТКРЫТЬ КОПИИ НАСТРОЕК ИГРЫ" Style="{StaticResource FlatButton}" HorizontalAlignment="Left" Click="OpenBackups_Click"/>

            <TextBlock Text="ДАННЫЕ" Style="{StaticResource Label}" Margin="0,30,0,0"/>
            <TextBlock Foreground="{StaticResource Muted}" FontSize="12.5" Margin="0,8,0,10" TextWrapping="Wrap"
                       Text="Источник: deadlock-api.com (открытая статистика сообщества). Обновляется автоматически раз в несколько часов."/>
            <StackPanel Orientation="Horizontal">
                <Button Content="ОТКРЫТЬ ПАПКУ С ЛОГОМ" Style="{StaticResource FlatButton}" Click="OpenData_Click"/>
                <Button Content="ВЫЙТИ ИЗ ПРОГРАММЫ" Style="{StaticResource FlatButton}" Margin="8,0,0,0" Click="Quit_Click"/>
            </StackPanel>
            <TextBlock x:Name="VersionText" Foreground="{StaticResource Muted}" FontSize="12.5" Margin="0,30,0,0"/>
        </StackPanel>
        </ScrollViewer>

        <!-- Hero details: slides in from the right over the table when a hero is clicked -->
        <Grid x:Name="DetailLayer" Grid.Row="2" Visibility="Collapsed">
            <Border x:Name="DetailDim" Background="#000000" Opacity="0" MouseLeftButtonDown="DetailDim_Click"/>
            <Border x:Name="DetailPanel" Width="620" HorizontalAlignment="Right" Background="{StaticResource Panel}"
                    BorderBrush="{StaticResource Line}" BorderThickness="1,0,0,0">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="DetailShift"/>
                </Border.RenderTransform>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Margin="24,18,12,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="42" Height="70" CornerRadius="2" BorderBrush="{StaticResource Line}" BorderThickness="1">
                            <Border.Background>
                                <ImageBrush x:Name="DetailCard" Stretch="UniformToFill"/>
                            </Border.Background>
                        </Border>
                        <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="DetailName" FontFamily="{StaticResource Display}" FontStretch="Condensed" FontWeight="Bold"
                                       FontSize="30" Foreground="{StaticResource Text}"/>
                            <TextBlock x:Name="DetailSub" Foreground="{StaticResource Muted}" FontSize="13"/>
                        </StackPanel>
                        <Button Grid.Column="2" Content="✕" Style="{StaticResource GhostButton}" FontFamily="{StaticResource Body}"
                                FontSize="14" Padding="12,8,12,8" VerticalAlignment="Top" Click="DetailClose_Click"/>
                    </Grid>
                    <ScrollViewer x:Name="DetailScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                        <StackPanel x:Name="DetailBody" Margin="24,0,24,24"/>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- Crosshair panel: one reticle up close, the editor, or pasting a code -->
        <Grid x:Name="CrossLayer" Grid.Row="2" Visibility="Collapsed">
            <Border x:Name="CrossDim" Background="#000000" Opacity="0" MouseLeftButtonDown="CrossDim_Click"/>
            <Border x:Name="CrossPanel" Width="580" HorizontalAlignment="Right" Background="{StaticResource Panel}"
                    BorderBrush="{StaticResource Line}" BorderThickness="1,0,0,0">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="CrossShift"/>
                </Border.RenderTransform>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Margin="24,16,12,10">
                        <TextBlock x:Name="CrossTitle" FontFamily="{StaticResource Display}" FontStretch="Condensed" FontWeight="Bold"
                                   FontSize="26" Foreground="{StaticResource Text}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,48,0"/>
                        <Button Content="✕" Style="{StaticResource GhostButton}" FontFamily="{StaticResource Body}" HorizontalAlignment="Right"
                                FontSize="14" Padding="12,8,12,8" VerticalAlignment="Top" Click="CrossClose_Click"/>
                    </Grid>
                    <ScrollViewer x:Name="CrossScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                        <StackPanel x:Name="CrossBody" Margin="24,0,24,24"/>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- Short confirmation, e.g. after copying a build ID -->
        <Border x:Name="Toast" Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,24"
                Background="{StaticResource Text}" CornerRadius="3" Padding="16,8,16,9" Opacity="0" IsHitTestVisible="False">
            <TextBlock x:Name="ToastText" Foreground="{StaticResource Bg}" FontSize="13.5" FontWeight="SemiBold" TextWrapping="Wrap" MaxWidth="560" TextAlignment="Center"/>
        </Border>
    </Grid>
</Window>
